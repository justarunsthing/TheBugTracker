@page "/company"
@attribute [Authorize]
@inject ICompanyDTOService CompanyService

<MudContainer MaxWidth="MaxWidth.Large">
    <MudBreadcrumbs Items="@breadcrumb" />

    @if (isLoading)
    {
        <LoadingSpinner Message="Loading your company details..." />
    }
    else if (company is null)
    {
        <div class="h-100 d-flex align-items-center justify-content-center flex-column">
            <MudText Typo="Typo.h6" GutterBottom>
                Something went wrong loading your company
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="OnInitializedAsync">
                Try Again?
            </MudButton>
        </div>
    }
    else
    {
        <div class="vstack gap-3">
            <MudPaper Class="p-3">
                Company details
            </MudPaper>

            <MudPaper Class="p-3">
                Company members
            </MudPaper>

            <MudPaper Class="p-3">
                Company invites
            </MudPaper>
        </div>
    }
</MudContainer>

    @code {
    private static readonly List<BreadcrumbItem> breadcrumb = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Company", href: null, disabled: true)
    };

    bool isLoading = true;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private UserInfo? userInfo;

    private CompanyDTO? company;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        userInfo = await UserInfoHelper.GetUserInfoAsync(AuthStateTask);

        try
        {
            company = await CompanyService.GetCompanyAsync(userInfo!);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }

        isLoading = false;
    }
}