@page "/projects/{id:int}"
@using TheBugTracker.Client.UI.Projects
@attribute [Authorize]
@inject IProjectDTOService ProjectService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="h-100">
    <MudBreadcrumbs Items="@breadcrumbs" />

    @if (isLoading)
    {
        <div class="h-100 d-flex flex-column align-items-center justify-content-center gap-3">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.button">
                Loading project...
            </MudText>
        </div>
    }
    else if (project is null)
    {
        <PageTitle>Not Found | The Bug Tracker</PageTitle>

        <div class="h-100 d-flex align-items-center justify-content-center text-center flex-column gap-2">
            <MudText Color="Color.Tertiary" Typo="Typo.button" Style="font-size: 1.2rem">
                Project not found
            </MudText>
            <MudButton Href="/projects" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small">
                Back to projects
            </MudButton>
        </div>
    }
    else
    {
        <PageTitle>@project.Name | The Bug Tracker</PageTitle>

        <div class="vstack gap-3">
            @* Project header *@
            <MudPaper Class="p-3">
                <div class="d-flex">
                    <MudText Typo="Typo.h5" GutterBottom Class="me-auto">
                        @project.Name
                    </MudText>

                    @if (project.IsArchived)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">
                            Archived
                        </MudChip>
                    }
                </div>
                <div>
                    <MudChip T="string"
                             Label="true"
                             Color="project.Priority.GetColor()">
                        Priority: @project.Priority.GetDisplayName()
                    </MudChip>
                    <MudChip T="string"
                             Variant="Variant.Text"
                             Label="true" Color="@(project.EndDate < DateTimeOffset.UtcNow ? Color.Error : Color.Default)">
                        @project.StartDateTime?.ToShortDateString() - @project.EndDateTime?.ToShortDateString()
                    </MudChip>
                </div>
            </MudPaper>

            @* Description *@
            <MudPaper Class="p-3">
                <MudText Typo="Typo.h6">
                    Description
                </MudText>
                <MudText Typo="Typo.body1">
                    @project.Description
                </MudText>
            </MudPaper>

            @* Project members*@
            <MudPaper Class="p-3">
                <MudText Typo="Typo.h6">
                    Project Members
                </MudText>

                @if (project.Members.Count == 0)
                {
                    <div class="p-5 text-center">
                        <MudText Typo="Typo.button" Color="Color.Tertiary">
                            No members assigned
                        </MudText>
                    </div>
                }
                else
                {
                    
                }

                <MudButton Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings">
                    Manage Team
                </MudButton>
            </MudPaper>

            @* Project tickets *@
            <MudPaper Class="p-3">
                <MudTabs>
                    <MudTabPanel Text="Open Tickets">
                        @if (project.IsArchived)
                        {
                            @* If the project is archived, "open" tickets are the tickets which were marked as archived by the project *@
                            <ProjectTicketTable Tickets="project.Tickets.Where(t => t.IsArchivedByProject && t.Status != TicketStatus.Resolved)" />
                        }
                        else
                        {
                            <ProjectTicketTable Tickets="project.Tickets.Where(t => !t.IsArchived && t.Status != TicketStatus.Resolved)" />
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="Resolved Tickets">
                        <ProjectTicketTable Tickets="project.Tickets.Where(t => (project.IsArchived ? t.IsArchivedByProject : !t.IsArchived) && t.Status == TicketStatus.Resolved)" />
                    </MudTabPanel>
                    <MudTabPanel Text="Archived Tickets">
                        <ProjectTicketTable Tickets="project.Tickets.Where(t => project.IsArchived ? !t.IsArchivedByProject : t.IsArchived)" />
                    </MudTabPanel>
                </MudTabs>
                <MudButton Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle">
                    New Ticket
                </MudButton>
            </MudPaper>

            @* Project controls *@
            <div class="d-flex">
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/projects">
                    Back to Projects
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" Class="ms-auto" Href=@($"/projects/edit/{project.Id}")>
                    Edit
                </MudButton>

                @if (project.IsArchived)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.RestoreFromTrash" Color="Color.Success" OnClick="ConfirmArchiveToggle">
                        Restore
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="ConfirmArchiveToggle">
                        Archive
                    </MudButton>
                }
            </div>
        </div>

        @* Archive/restore project mud message box*@
        <MudMessageBox @ref="archiveConfirmationBox" Title="@(project.IsArchived ? "Restore Project" : "Archive Project")" CancelText="Cancel">
            <MessageContent>
                Are you sure you want to @(project.IsArchived ? "restore" : "archive") this project?
            </MessageContent>
            <YesButton>
                @if (project.IsArchived)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.RestoreFromTrash" Class="ms-2" OnClick="HandleArchiveToggle">
                        Restore
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Class="ms-2" OnClick="HandleArchiveToggle">
                        Archive
                    </MudButton>
                }
            </YesButton>
        </MudMessageBox>
    }
</MudContainer>

    @code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private UserInfo? userInfo;
    private ProjectDTO? project;
    private List<BreadcrumbItem> breadcrumbs = [];
    private bool isLoading = true;
    private MudMessageBox? archiveConfirmationBox;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        userInfo ??= await UserInfoHelper.GetUserInfoAsync(AuthStateTask);

        try
        {
            project = await ProjectService.GetProjectByIdAsync(Id, userInfo!);

            if (project is null)
            {
                breadcrumbs =
                [
                    new BreadcrumbItem("Home", href: "/"),
                    new BreadcrumbItem("Projects", href: "/projects"),
                    new BreadcrumbItem("Not Found", href: null, disabled: true)
                ];
            }
            else
            {
                breadcrumbs =
                [
                    new BreadcrumbItem("Home", href: "/"),
                    new BreadcrumbItem("Projects", href: "/projects"),
                    new BreadcrumbItem(project.Name!, href: null, disabled: true)
                ];
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Snackbar.Add("An error occurred loading the project!", Severity.Error);
        }

        isLoading = false;
    }

    private async Task ConfirmArchiveToggle()
    {
        if (archiveConfirmationBox is not null)
        {
            await archiveConfirmationBox.ShowAsync();
        }
    }

    private async Task HandleArchiveToggle()
    {
        if (project is null)
        {
            return;
        }

        try
        {
            if (project.IsArchived)
            {
                await ProjectService.RestoreProjectAsync(project.Id, userInfo!);
            }
            else
            {
                await ProjectService.ArchiveProjectAsync(project.Id, userInfo!);
            }

            // Refresh the info on the page
            project = await ProjectService.GetProjectByIdAsync(project.Id, userInfo!);
            Snackbar.Add($"The project has successfully been {(project!.IsArchived ? "archived" : "restored")}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Snackbar.Add("An error occurred archiving/restoring the project!", Severity.Error);
        }
    }
}