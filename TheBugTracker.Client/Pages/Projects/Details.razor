@page "/projects/{id:int}"
@using TheBugTracker.Client.UI.Projects
@attribute [Authorize]
@inject IProjectDTOService ProjectService
@inject ICompanyDTOService CompanyService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="h-100">
    <MudBreadcrumbs Items="@breadcrumbs" />

    @if (isLoading)
    {
        <LoadingSpinner Message="Loading project..." />
    }
    else if (project is null)
    {
        <PageTitle>Not Found | The Bug Tracker</PageTitle>

        <div class="h-100 d-flex align-items-center justify-content-center text-center flex-column gap-2">
            <MudText Color="Color.Tertiary" Typo="Typo.button" Style="font-size: 1.2rem">
                Project not found
            </MudText>
            <MudButton Href="/projects" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small">
                Back to projects
            </MudButton>
        </div>
    }
    else
    {
        <PageTitle>@project.Name | The Bug Tracker</PageTitle>

        <div class="vstack gap-3">
            @* Project header *@
            <MudPaper Class="p-3">
                <div class="d-flex">
                    <MudText Typo="Typo.h5" GutterBottom Class="me-auto">
                        @project.Name
                    </MudText>

                    @if (project.IsArchived)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">
                            Archived
                        </MudChip>
                    }
                </div>
                <div>
                    <MudChip T="string"
                             Label="true"
                             Color="project.Priority.GetColor()">
                        Priority: @project.Priority.GetDisplayName()
                    </MudChip>
                    <MudChip T="string"
                             Variant="Variant.Text"
                             Label="true" Color="@(project.EndDate < DateTimeOffset.UtcNow ? Color.Error : Color.Default)">
                        @project.StartDateTime?.ToShortDateString() - @project.EndDateTime?.ToShortDateString()
                    </MudChip>
                </div>
                <div class="mt-2 hstack gap-2">
                    <UserCard User="projectManager"
                              PlaceholderName="Unassigned"
                              PlaceholderRole="@Role.ProjectManager.GetDisplayName()" />

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small" Variant="Variant.Text"
                                   OnClick="() => isProjectManagerDialogVisible = true" />
                </div>
            </MudPaper>

            @* Description *@
            <MudPaper Class="p-3">
                <MudText Typo="Typo.h6">
                    Description
                </MudText>
                <MudText Typo="Typo.body1">
                    @project.Description
                </MudText>
            </MudPaper>

            @* Project members*@
            <MudPaper Class="p-3">
                <MudText Typo="Typo.h6">
                    Project Members
                </MudText>

                @if (project.Members.Where(m => m.Role != Role.ProjectManager).Count() == 0)
                {
                    <div class="p-5 text-center">
                        <MudText Typo="Typo.button" Color="Color.Tertiary">
                            No members assigned
                        </MudText>
                    </div>
                }
                else
                {
                    <div class="row g-3 py-3 row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5">
                        @foreach (var member in project.Members.Where(m => m.Role != Role.ProjectManager))
                        {
                            <div class="col">
                                <UserCard User="member" />
                            </div>
                        }
                    </div>
                }

                <MudButton Size="Size.Small"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Settings"
                           OnClick="() => isMemberDialogVisible = true">
                    Manage Team
                </MudButton>
            </MudPaper>

            @* Project tickets *@
            <MudPaper Class="p-3">
                <MudTabs>
                    <MudTabPanel Text="Open Tickets">
                        @if (project.IsArchived)
                        {
                            @* If the project is archived, "open" tickets are the tickets which were marked as archived by the project *@
                            <ProjectTicketTable Tickets="project.Tickets.Where(t => t.IsArchivedByProject && t.Status != TicketStatus.Resolved)" />
                        }
                        else
                        {
                            <ProjectTicketTable Tickets="project.Tickets.Where(t => !t.IsArchived && t.Status != TicketStatus.Resolved)" />
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="Resolved Tickets">
                        <ProjectTicketTable Tickets="project.Tickets.Where(t => (project.IsArchived ? t.IsArchivedByProject : !t.IsArchived) && t.Status == TicketStatus.Resolved)" />
                    </MudTabPanel>
                    <MudTabPanel Text="Archived Tickets">
                        <ProjectTicketTable Tickets="project.Tickets.Where(t => project.IsArchived ? !t.IsArchivedByProject : t.IsArchived)" />
                    </MudTabPanel>
                </MudTabs>
                <MudButton Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle">
                    New Ticket
                </MudButton>
            </MudPaper>

            @* Project controls *@
            <div class="d-flex">
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/projects">
                    Back to Projects
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" Class="ms-auto" Href=@($"/projects/edit/{project.Id}")>
                    Edit
                </MudButton>

                @if (project.IsArchived)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.RestoreFromTrash" Color="Color.Success" OnClick="ConfirmArchiveToggle">
                        Restore
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="ConfirmArchiveToggle">
                        Archive
                    </MudButton>
                }
            </div>
        </div>

        @* Archive/restore project mud message box *@
        <MudMessageBox @ref="archiveConfirmationBox" Title="@(project.IsArchived ? "Restore Project" : "Archive Project")" CancelText="Cancel">
            <MessageContent>
                Are you sure you want to @(project.IsArchived ? "restore" : "archive") this project?
            </MessageContent>
            <YesButton>
                @if (project.IsArchived)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.RestoreFromTrash" Class="ms-2" OnClick="HandleArchiveToggle">
                        Restore
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Class="ms-2" OnClick="HandleArchiveToggle">
                        Archive
                    </MudButton>
                }
            </YesButton>
        </MudMessageBox>

        @* Manage project members mud dialog box *@
        <MudDialog @bind-Visible="isMemberDialogVisible">
            <TitleContent>
                <MudText Typo="Typo.h5">
                    Manage Project Team
                </MudText>
            </TitleContent>
            <DialogContent>
                <ProjectMemberManager Project="project" OnClose="() => isMemberDialogVisible = false" />
            </DialogContent>
        </MudDialog>

        @* Manage project manager mud dialog box *@
        <MudDialog @bind-Visible="isProjectManagerDialogVisible">
            <TitleContent>
                <MudText Typo="Typo.h5">
                    Assign Project Manager
                </MudText>
            </TitleContent>
            <DialogContent>
                <div class="vstack gap-3">
                    <UserCard User="projectManagers.FirstOrDefault(pm => pm.Id == selectedPmId)"
                              PlaceholderName="Unassigned"
                              PlaceholderRole="@Role.ProjectManager.GetDisplayName()" />

                    <MudSelect Label="Project Manager"
                               @bind-Value="selectedPmId"
                               Variant="Variant.Outlined"
                               Clearable
                               Placeholder="Select a project manager">
                        @foreach (var pm in projectManagers)
                        {
                            <MudSelectItem Value="pm.Id">
                                <div class="hstack gap-2 align-items-center">
                                    <MudAvatar Size="Size.Small">
                                        <MudImage Src="@pm.ImageUrl" />
                                    </MudAvatar>
                                    @pm.FullName
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </DialogContent>
            <DialogActions>
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Cancel"
                           OnClick="HandleCancelProjectManager">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="HandleSaveProjectManager">
                    Save
                </MudButton>
            </DialogActions>
        </MudDialog>
    }
</MudContainer>

    @code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private UserInfo? userInfo;
    private ProjectDTO? project;
    private List<BreadcrumbItem> breadcrumbs = [];
    private bool isLoading = true;
    private bool isMemberDialogVisible = false;
    private MudMessageBox? archiveConfirmationBox;
    private UserDTO? projectManager;
    private IEnumerable<UserDTO> projectManagers = [];
    private bool isProjectManagerDialogVisible = false;
    private string? selectedPmId;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        userInfo ??= await UserInfoHelper.GetUserInfoAsync(AuthStateTask);

        try
        {
            project = await ProjectService.GetProjectByIdAsync(Id, userInfo!);
            breadcrumbs =
            [
                new BreadcrumbItem("Home", href: "/"),
                new BreadcrumbItem("Projects", href: "/projects"),
        ];

            if (project is null)
            {
                breadcrumbs.Add(new BreadcrumbItem("Not Found", href: null, disabled: true));
            }
            else
            {
                if (project.IsArchived)
                {
                    breadcrumbs.Add(new BreadcrumbItem("Archive", href: "/projects/archive"));
                }

                breadcrumbs.Add(new BreadcrumbItem(project.Name!, href: null, disabled: true));

                projectManagers = await CompanyService.GetUsersInRoleAsync(Role.ProjectManager, userInfo!);
                projectManager = project.Members.FirstOrDefault(m => m.Role == Role.ProjectManager);
                selectedPmId = projectManager?.Id;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Snackbar.Add("An error occurred loading the project!", Severity.Error);
        }

        isLoading = false;
    }

    private async Task ConfirmArchiveToggle()
    {
        if (archiveConfirmationBox is not null)
        {
            await archiveConfirmationBox.ShowAsync();
        }
    }

    private async Task HandleArchiveToggle()
    {
        if (project is null)
        {
            return;
        }

        try
        {
            if (project.IsArchived)
            {
                await ProjectService.RestoreProjectAsync(project.Id, userInfo!);
            }
            else
            {
                await ProjectService.ArchiveProjectAsync(project.Id, userInfo!);
            }

            // Refresh the info on the page
            project = await ProjectService.GetProjectByIdAsync(project.Id, userInfo!);
            Snackbar.Add($"The project has successfully been {(project!.IsArchived ? "archived" : "restored")}", Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Snackbar.Add("An error occurred archiving/restoring the project!", Severity.Error);
        }
    }

    private void HandleCancelProjectManager()
    {
        selectedPmId = projectManager?.Id;
        isProjectManagerDialogVisible = false;
    }

    private async Task HandleSaveProjectManager()
    {
        try
        {
            isProjectManagerDialogVisible = false;

            if (string.IsNullOrEmpty(selectedPmId))
            {
                await ProjectService.RemoveProjectManagerAsync(Id, userInfo!);
            }
            else
            {
                await ProjectService.AssignProjectManagerAsync(Id, selectedPmId, userInfo!);
            }

            project!.Members = [.. await ProjectService.GetProjectMembersAsync(Id, userInfo!)];
            projectManager = project.Members.FirstOrDefault(m => m.Role == Role.ProjectManager);
            selectedPmId = projectManager?.Id;

            Snackbar.Add("Project manager has been updated successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Snackbar.Add("Failed to update project manager!", Severity.Error);
        }
    }
}