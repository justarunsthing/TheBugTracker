@page "/tickets/{id:int}"
@attribute [Authorize]
@inject ITicketDTOService TicketService
@inject IProjectDTOService ProjectService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@if (ticket is not null)
{
    <PageTitle>@ticket.Title | The Bug Tracker</PageTitle>

    <MudContainer MaxWidth="MaxWidth.Large">
        <MudBreadcrumbs Items="breadcrumbs" />

        <div class="vstack gap-3">
            <MudPaper Class="p-3">
                <div class="d-flex">
                    <MudText Typo="Typo.h5" GutterBottom Class="me-auto">
                        @ticket.Title
                    </MudText>

                    @if (ticket.IsArchived)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">
                            Archived
                        </MudChip>
                    }
                </div>
                <div>
                    <MudText Typo="Typo.subtitle2" Inline="true">
                        Submitted @ticket.Created.ToString("g")
                    </MudText>

                    @if (ticket.Updated.HasValue)
                    {
                        <span class="mx-1">&bull;</span>
                        <MudText Typo="Typo.subtitle2" Inline>
                            Updated @ticket.Updated.Value.ToString("g")
                        </MudText>
                    }
                </div>
            </MudPaper>

            <div class="row row-cols-1 row-cols-sm-2 g-3">
                <div class="col">
                    <MudPaper Class="p-3 h-100">
                        <MudText Typo="Typo.h6">
                            Submitted By:
                        </MudText>
                        <UserCard User="ticket.SubmitterUser" />
                    </MudPaper>
                </div>
                <div class="col">
                    <MudPaper Class="p-3 h-100">
                        <MudText Typo="Typo.h6">
                            Assigned To:
                        </MudText>
                        <div class="d-flex align-items-center">
                            @if (assigningDeveloper == false)
                            {
                                <UserCard User="ticket.DeveloperUser"
                                          PlaceholderName="Unassigned"
                                          PlaceholderRole="@Role.Developer.GetDisplayName()" />

                                @if (userCanEditTicket)
                                {
                                    <AuthorizeView Roles="@($"{nameof(Role.Admin)}, {nameof(Role.ProjectManager)}")">
                                        <MudIconButton Class="ms-auto"
                                                       Icon="@Icons.Material.Filled.Edit"
                                                       OnClick="() => assigningDeveloper = true" />
                                    </AuthorizeView>
                                }
                            }
                            else
                            {
                                <UserCard User="ticket.DeveloperUser"
                                          PlaceholderName="Unassigned"
                                          PlaceholderRole="@Role.Developer.GetDisplayName()" />

                                <MudIconButton Class="ms-auto"
                                               Icon="@Icons.Material.Filled.Save"
                                               Color="Color.Success"
                                               OnClick="() => assigningDeveloper = false" />
                            }
                        </div>
                    </MudPaper>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-md-3 g-3">
                <div class="col">
                    <MudPaper Class="p-3 h-100 d-flex justify-content-between align-items-center">
                        <MudText Typo="Typo.h6">
                            Priority
                        </MudText>
                        <MudChip T="string" Label="true" Color="ticket.Priority.GetColor()">
                            @ticket.Priority.GetDisplayName()
                        </MudChip>
                    </MudPaper>
                </div>
                <div class="col">
                    <MudPaper Class="p-3 h-100 d-flex justify-content-between align-items-center">
                        <MudText Typo="Typo.h6">
                            Status
                        </MudText>
                        <MudChip T="string" Label="true" Color="ticket.Status.GetColor()">
                            @ticket.Status.GetDisplayName()
                        </MudChip>
                    </MudPaper>
                </div>
                <div class="col">
                    <MudPaper Class="p-3 h-100 d-flex justify-content-between align-items-center">
                        <MudText Typo="Typo.h6">
                            Type
                        </MudText>
                        <MudChip T="string" Label="true" Color="ticket.Type.GetColor()">
                            @ticket.Type.GetDisplayName()
                        </MudChip>
                    </MudPaper>
                </div>
            </div>

            <MudPaper Class="p-3">
                <MudText Typo="Typo.h6" GutterBottom>
                    Description
                </MudText>
                <MudText Typo="Typo.body1">
                    @ticket.Description
                </MudText>
            </MudPaper>

            <div class="d-flex">
                <MudButton Variant="Variant.Text" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Class="me-auto"
                           Href="@($"projects/{ticket.ProjectId}")">
                    Back to Project
                </MudButton>

                @if (userCanEditTicket)
                {
                    <MudButton Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Href="@($"tickets/edit/{ticket.Id}")">
                        Edit
                    </MudButton>

                    @if (ticket.IsArchived)
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.RestoreFromTrash"
                                   OnClick="HandleArchiveToggle">
                            Restore
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="HandleArchiveToggle">
                            Archive
                        </MudButton>
                    }
                }
            </div>
        </div>
    </MudContainer>

    @if (userCanEditTicket)
    {
        <MudMessageBox @ref="archiveConfirmationBox"
                       Title="@(ticket.IsArchived ? "Restore Ticket" : "Archive Ticket")"
                       CancelText="Cancel">
            <MessageContent>
                Are you sure you want to @(ticket.IsArchived ? "Restore" : "Archive") this ticket?
            </MessageContent>

            <YesButton>
                @if (ticket.IsArchived)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.RestoreFromTrash"
                               Class="ms-2">
                        Restore
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Delete"
                               Class="ms-2">
                        Archive
                    </MudButton>
                }
            </YesButton>
        </MudMessageBox>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private UserInfo? userInfo;

    private TicketDTO? ticket;
    private bool userCanEditTicket = false;
    private bool assigningDeveloper = false;
    private List<BreadcrumbItem> breadcrumbs = [];
    private MudMessageBox? archiveConfirmationBox;

    protected override async Task OnParametersSetAsync()
    {
        userInfo = await UserInfoHelper.GetUserInfoAsync(AuthStateTask);

        try
        {
            ticket = await TicketService.GetTicketByIdAsync(Id, userInfo!);

            if (ticket is not null)
            {
                breadcrumbs = [ new BreadcrumbItem("Home", href: "/")];

                if (ticket.Project is null)
                {
                    breadcrumbs.Add(new BreadcrumbItem("Tickets", href: "/tickets"));

                    if (ticket.IsArchived)
                    {
                        breadcrumbs.Add(new BreadcrumbItem("Archive", href: "/tickets/archived"));
                    }
                }
                else
                {
                    breadcrumbs.Add(new BreadcrumbItem("Projects", href: "/projects"));
                    breadcrumbs.Add(new BreadcrumbItem(ticket.Project.Name!, href: "/projects"));
                }

                breadcrumbs.Add(new BreadcrumbItem(ticket.Title!, href: null, disabled: true));

                UserDTO? projectManager = await ProjectService.GetProjectManagerAsync(ticket.ProjectId, userInfo!);

                userCanEditTicket = ticket.SubmitterUserId == userInfo!.UserId
                                    || ticket.DeveloperUserId == userInfo.UserId
                                    || userInfo.IsInRole(Role.Admin)
                                    || projectManager?.Id == userInfo.UserId;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Snackbar.Add("An error occurred loading the ticket!", Severity.Error);
        }

        if (ticket is null)
        {
            Nav.NavigateTo("tickets");
        }
    }

    private async Task HandleArchiveToggle()
    {
        if (userCanEditTicket && archiveConfirmationBox is not null)
        {
            bool? confirmed = await archiveConfirmationBox.ShowAsync();

            if (confirmed == true)
            {
                try
                {
                    if (ticket!.IsArchived)
                    {
                        await TicketService.RestoreTicketAsync(ticket.Id, userInfo!);
                        Snackbar.Add("The ticket has been successfully restored!", Severity.Success);
                    }
                    else
                    {
                        await TicketService.ArchiveTicketAsync(ticket.Id, userInfo!);
                        Snackbar.Add("The ticke has been successfully archived!", Severity.Success);
                    }

                    ticket = await TicketService.GetTicketByIdAsync(ticket.Id, userInfo!);
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex);
                    Snackbar.Add("An error occurred updating the ticket!", Severity.Error);
                }
            }
        }
    }
}