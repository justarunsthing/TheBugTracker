@page "/tickets/edit/{id:int}"
@attribute [Authorize]
@inject ITicketDTOService TicketService
@inject IProjectDTOService ProjectService
@inject ISnackbar SnackBar
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="h-100">
    <MudBreadcrumbs Items="breadcrumbs" />

    @if (isLoading)
    {
        <PageTitle>Edit Ticket | The Bug Tracker</PageTitle>

        <LoadingSpinner Message="Loading ticket..." />
    }
    else if (ticket is null)
    {
        <PageTitle>Not Found | The Bug Tracker</PageTitle>

        <div class="h-100 d-flex flex-column gap-2 align-items-center justify-content-center">
            <MudText Color="Color.Tertiary" Typo="Typo.button">
                Ticket Not Found
            </MudText>
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       Href="tickets"
                       StartIcon="@Icons.Material.Filled.ArrowBack">
                Back to Tickets
            </MudButton>
        </div>
    }
    else
    {
        <PageTitle>Edit @ticket.Title | The Bug Tracker</PageTitle>

        <MudPaper Class="p-3">
            <MudText Typo="Typo.h5">
                Edit Ticket
            </MudText>

            <EditForm Model="ticket" class="vstack gap-3" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="ticket.Title"
                              For="() => ticket.Title"
                              Label="Title"
                              Variant="Variant.Outlined" />

                <MudTextField @bind-Value="ticket.Description"
                              For="() => ticket.Description"
                              Label="Description"
                              Variant="Variant.Outlined"
                              Lines="5"
                              AutoGrow
                              MaxLines="15" />

                <MudSelect @bind-Value="ticket.ProjectId"
                           For="() => ticket.ProjectId"
                           Label="Project"
                           Variant="Variant.Outlined"
                           Disabled>
                    <MudSelectItem Value="ticket.ProjectId">
                        @(ticket.Project?.Name ?? "Unknown")
                    </MudSelectItem>
                </MudSelect>

                <div class="hstack flex-wrap gap-3 align-items-start">
                    <MudSelect Value="ticket.SubmitterUserId"
                               For="() => ticket.SubmitterUserId"
                               Label="Submitter"
                               Variant="Variant.Outlined"
                               Disabled>

                        <MudSelectItem Value="ticket.SubmitterUserId">
                            @(ticket.SubmitterUser?.FullName ?? "Unknown")
                        </MudSelectItem>
                    </MudSelect>

                    <MudSelect @bind-Value="ticket.DeveloperUserId"
                               For="() => ticket.DeveloperUserId"
                               Label="Developer"
                               Variant="Variant.Outlined"
                               Disabled="@(developers.Count() == 0 || !canUserAssignTickets)"
                               Placeholder="@(developers.Any() ? "Select a Developer" : "No developers available")">

                        @foreach (UserDTO developer in developers)
                        {
                            <MudSelectItem Value="developer.Id">
                                @developer.FullName
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div>
                    <MudField Variant="Variant.Outlined" Label="Ticket Status">
                        <MudChipSet @bind-SelectedValue="ticket.Status"
                                    CheckMark="true">

                            @foreach (TicketStatus status in Enum.GetValues<TicketStatus>())
                            {
                                <MudChip Value="status" Color="status.GetColor()" Text="@status.GetDisplayName()">
                                    @status
                                </MudChip>
                            }
                        </MudChipSet>
                    </MudField>
                    <ValidationMessage For="() => ticket.Status" />
                </div>

                <div>
                    <MudField Variant="Variant.Outlined" Label="Ticket Type">
                        <MudChipSet @bind-SelectedValue="ticket.Type"
                                    CheckMark="true">

                            @foreach (TicketType type in Enum.GetValues<TicketType>())
                            {
                                <MudChip Value="type" Color="type.GetColor()" Text="@type.GetDisplayName()">
                                    @type
                                </MudChip>
                            }
                        </MudChipSet>
                    </MudField>
                    <ValidationMessage For="() => ticket.Type" />
                </div>

                <div>
                    <MudField Variant="Variant.Outlined" Label="Ticket Priority">
                        <MudChipSet @bind-SelectedValue="ticket.Priority"
                                    CheckMark="true">

                            @foreach (TicketPriority priority in Enum.GetValues<TicketPriority>())
                            {
                                <MudChip Value="priority" Color="priority.GetColor()" Text="@priority.GetDisplayName()">
                                    @priority
                                </MudChip>
                            }
                        </MudChipSet>
                    </MudField>
                    <ValidationMessage For="() => ticket.Priority" />
                </div>

                <div class="d-flex justify-content-between mt-5">
                    <MudButton Variant="Variant.Text"
                               Href="@($"tickets/{Id}")"
                               StartIcon="@Icons.Material.Filled.ArrowBack">
                        Back to Ticket
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               ButtonType="ButtonType.Submit">
                        Save Changes
                    </MudButton>
                </div>
            </EditForm>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private UserInfo? userInfo;

    private TicketDTO? ticket { get; set; }
    private List<BreadcrumbItem> breadcrumbs = [];
    private bool isLoading = true;
    private IEnumerable<UserDTO> developers = [];
    private bool canUserAssignTickets = false;

    protected override async Task OnParametersSetAsync()
    {
        userInfo ??= await UserInfoHelper.GetUserInfoAsync(AuthStateTask);

        try
        {
            ticket = await TicketService.GetTicketByIdAsync(Id, userInfo!);

            if (ticket is not null)
            {
                breadcrumbs = new List<BreadcrumbItem>()
                {
                    new("Home", href: "/"),
                    new("Tickets", href: "/tickets"),
                    new(ticket.Title!, href: $"/tickets/{Id}"),
                    new("Edit Ticket", href: null, disabled: true)
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            SnackBar.Add("Failed to load ticket!", Severity.Error);
        }

        isLoading = false;
    }

    private async Task HandleSubmit()
    {
        SnackBar.Add("Form Submitted!");
    }
}