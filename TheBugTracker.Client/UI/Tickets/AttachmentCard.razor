@if (Attachment is not null)
{
    <MudCard Class="h-100">
        <MudCardMedia Image="@($"img/png/{extension}.png")"
                      Style="background-size: contain; border: 8px inset transparent;"
                      Height="96" />

        <MudCardContent>
            <MudText Typo="Typo.body1" class="text-truncate">
                @Attachment.FileName
            </MudText>

            <MudText Typo="Typo.caption">
                @Attachment.User?.FullName
            </MudText>

            <MudCollapse Expanded="isDescriptionExpanded">
                <MudText Typo="Typo.body2" class="py-2">
                    @Attachment.Description
                </MudText>

                <MudText Typo="Typo.caption">
                    @Attachment.Created.ToString("g")
                </MudText>
            </MudCollapse>
        </MudCardContent>

        <MudCardActions>
            <MudIconButton Icon="@Icons.Material.Filled.Info"
                           Size="Size.Medium"
                           OnClick="() => isDescriptionExpanded = !isDescriptionExpanded" />

            <MudIconButton Icon="@Icons.Material.Filled.Download"
                           Href="@Attachment.AttachmentUrl"
                           Target="_blank"
                           Size="Size.Medium" />

            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Medium"
                           class="ms-auto" />
        </MudCardActions>
    </MudCard>
}

@code {
    [Parameter, EditorRequired]
    public TicketAttachmentDTO? Attachment { get; set; }

    string extension = "default";
    bool isDescriptionExpanded = false;

    protected override void OnParametersSet()
    {
        extension = Path.GetExtension(Attachment?.FileName)?.Trim('.') ?? "default";
    }
}