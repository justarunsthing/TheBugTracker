<MudPaper>
    <div class="p-3">
        <MudText Typo="Typo.h6">
            Comments
        </MudText>
    </div>
    <MudDivider DividerType="DividerType.FullWidth" Light />
    <div class="p-3 d-flex flex-column-reverse gap-3" 
         style="background-color: var(--mud-palette-background); min-height: 150px; max-height: 400px; overflow-y: auto;">
        @foreach (TicketCommentDTO comment in Comments)
        {
            <TicketComment Comment="comment" />
        }
    </div>

    @if (CanComment)
    {
        <MudDivider DividerType="DividerType.FullWidth" Light />
        <EditForm Model="newComment" 
                  OnValidSubmit="HandleSubmit" 
                  class="p-3 d-flex gap-2 align-items-end">

            <DataAnnotationsValidator />

            <MudTextField Lines="3"
                          AutoGrow
                          Variant="Variant.Outlined"
                          Class="flex-grow-1"
                          Label="Add a comment"
                          @bind-Value="newComment.Content"
                          For="() => newComment.Content" />
            <MudIconButton Color="Color.Primary"
                           Icon="@Icons.Material.Filled.Send"
                           ButtonType="ButtonType.Submit" />
        </EditForm>
    }
</MudPaper>

    @code {
    [Parameter]
    public IEnumerable<TicketCommentDTO> Comments { get; set; } = [];

    [Parameter]
    public bool CanComment { get; set; } = false;

    [Parameter, EditorRequired]
    public EventCallback<TicketCommentDTO> OnAdd { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private UserInfo? userInfo;

    TicketCommentDTO newComment = new();

    protected override async Task OnParametersSetAsync()
    {
        userInfo = await UserInfoHelper.GetUserInfoAsync(AuthStateTask);

        if (userInfo is null)
        {
            CanComment = false;
            return;
        }

        newComment = new TicketCommentDTO()
        {
            UserId = userInfo.UserId
        };
    }

    private async Task HandleSubmit()
    {
        if (CanComment)
        {
            await OnAdd.InvokeAsync(newComment);

            newComment = new()
            {
                UserId = userInfo!.UserId
            };
        }
    }
}