@if (Comment is not null)
{
    <div class="d-flex gap-2 align-items-start @(Comment.UserId == userInfo?.UserId ? "flex-row-reverse" : "flex-row")">
        <MudAvatar>
            <MudImage Src="@Comment.User?.ImageUrl" />
        </MudAvatar>

        <div class="@(isEditing ? "flex-grow-1" : "")">
            <MudPaper Class="px-3 py-2">
                <MudText Typo="Typo.overline"
                         Style="line-height: 1em"
                         GutterBottom>
                    @Comment.User?.FullName
                </MudText>

                @if (!isEditing)
                {
                    <MudText Typo="Typo.body1">
                        @Comment.Content
                    </MudText>
                }
                else
                {
                    <MudTextField @bind-Value="Comment.Content"
                                  Variant="Variant.Outlined"
                                  Label="Comment"
                                  Lines="4"
                                  AutoGrow
                                  For="() => Comment.Content" />
                }
            </MudPaper>

            <div class="@(Comment.UserId == userInfo?.UserId ? "text-end" : "text-start")">
                <MudText Typo="Typo.caption" Inline>
                    @Comment.Created.ToString("g")
                </MudText>
            </div>
        </div>

        <div class="vstack gap-1 flex-grow-0">
            @if (!isEditing)
            {
                @if (Comment.UserId == userInfo?.UserId)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   OnClick="() => isEditing = true" />
                }

                @if (Comment.UserId == userInfo?.UserId || userInfo?.IsInRole(Role.Admin) == true)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small" />
                }
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.Save"
                               Size="Size.Small"
                               Color="Color.Success"
                               ButtonType="ButtonType.Submit" />

                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="() => isEditing = false" />
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public TicketCommentDTO? Comment { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private UserInfo? userInfo;

    private bool isEditing = false;

    protected override async Task OnParametersSetAsync()
    {
        userInfo = await UserInfoHelper.GetUserInfoAsync(AuthStateTask);
    }
}