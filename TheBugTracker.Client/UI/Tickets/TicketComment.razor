@if (Comment is not null)
{
    <EditForm Model="formComment" 
              class="@(Comment.UserId == userInfo?.UserId 
                        ? "flex-row-reverse d-flex gap-2 align-items-start" 
                        : "flex-row d-flex gap-2 align-items-start")">

        <DataAnnotationsValidator />

        <MudAvatar>
            <MudImage Src="@Comment.User?.ImageUrl" />
        </MudAvatar>

        <div class="@(isEditing ? "flex-grow-1" : "")">
            <MudPaper Class="px-3 py-2">
                <MudText Typo="Typo.overline"
                         Style="line-height: 1em"
                         GutterBottom>
                    @Comment.User?.FullName
                </MudText>

                @if (!isEditing)
                {
                    <MudText Typo="Typo.body1">
                        @Comment.Content
                    </MudText>
                }
                else
                {
                    <MudTextField @bind-Value="formComment.Content"
                                  Variant="Variant.Outlined"
                                  Label="Comment"
                                  Lines="3"
                                  AutoGrow
                                  For="() => formComment.Content" />
                }
            </MudPaper>

            <div class="@(Comment.UserId == userInfo?.UserId ? "text-end" : "text-start")">
                <MudText Typo="Typo.caption" Inline>
                    @Comment.Created.ToString("g")
                </MudText>
            </div>
        </div>

        <div class="vstack gap-1 flex-grow-0">
            @if (!isEditing)
            {
                @if (Comment.UserId == userInfo?.UserId)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   OnClick="() => isEditing = true" />
                }

                @if (Comment.UserId == userInfo?.UserId || userInfo?.IsInRole(Role.Admin) == true)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small" />
                }
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.Save"
                               Size="Size.Small"
                               Color="Color.Success"
                               ButtonType="ButtonType.Submit" />

                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="CancelEdit" />
            }
        </div>
    </EditForm>
}

@code {
    [Parameter, EditorRequired]
    public TicketCommentDTO? Comment { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private UserInfo? userInfo;

    private bool isEditing = false;
    private TicketCommentDTO formComment = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Comment is null)
        {
            return;
        }

        userInfo = await UserInfoHelper.GetUserInfoAsync(AuthStateTask);
        formComment = new TicketCommentDTO
        {
            Id = Comment.Id,
            Content = Comment.Content,
            TicketId = Comment.TicketId,
            Created = Comment.Created,
            UserId = Comment.UserId
        };
    }

    private void CancelEdit()
    {
        if (Comment is not null)
        {
            formComment.Content = Comment.Content;
        }

        isEditing = false;
    }
}