@inject ISnackbar Snackbar
@inject IInviteDTOService InviteDTOService

<MudTabs>
    <MudTabPanel Text="Pending">
        <MudDataGrid Items="PendingInvites" Elevation="0">
            <Columns>
                <TemplateColumn>
                    <CellTemplate>
                        <AuthorizeView Roles="@nameof(Role.Admin)" Context="authContext">
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     Dense
                                     Size="Size.Small">
                                <MudMenuItem Icon="@Icons.Material.Filled.Mail">
                                    Resend
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Cancel" 
                                             IconColor="Color.Error"
                                             OnClick="async () => await HandleCancelInviteAsync(context.Item.Id)">
                                    Cancel
                                </MudMenuItem>
                            </MudMenu>
                        </AuthorizeView>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Title="Invitee" Property="i => i.InviteeFullName">
                    <CellTemplate>
                        <div class="vstack">
                            <MudText Typo="Typo.body1">
                                @context.Item.InviteeFullName
                            </MudText>
                            <MudText Typo="Typo.caption" Style="line-height: 1em">
                                @context.Item.InviteeEmail
                            </MudText>
                        </div>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Title="Project" Property="@(i => i.Project != null ? i.Project.Name : "Unknown")" />
                <PropertyColumn Title="Sent" Property="i => i.InviteDate" Format="g" />
            </Columns>
            <NoRecordsContent>
                <div class="py-3 text-center">
                    <MudText Typo="Typo.button" Color="Color.Tertiary">
                        No Pending Invites
                    </MudText>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </MudTabPanel>
    <MudTabPanel Text="Accepted">
        <MudDataGrid Items="AcceptedInvites" Elevation="0">
            <Columns>
                <PropertyColumn Title="Invitee" Property="i => i.InviteeFullName">
                    <CellTemplate>
                        <div class="vstack">
                            <MudText Typo="Typo.body1">
                                @context.Item.InviteeFullName
                            </MudText>
                            <MudText Typo="Typo.caption" Style="line-height: 1em">
                                @context.Item.InviteeEmail
                            </MudText>
                        </div>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Title="Project" Property="@(i => i.Project != null ? i.Project.Name : "Unknown")" />
                <PropertyColumn Title="Sent" Property="i => i.InviteDate" Format="g" />
            </Columns>
            <NoRecordsContent>
                <div class="py-3 text-center">
                    <MudText Typo="Typo.button" Color="Color.Tertiary">
                        No Accepted Invites
                    </MudText>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </MudTabPanel>
    <MudTabPanel Text="Cancelled/Expired">
        <MudDataGrid Items="ExpiredInvites" Elevation="0">
            <Columns>
                <PropertyColumn Title="Invitee" Property="i => i.InviteeFullName">
                    <CellTemplate>
                        <div class="vstack">
                            <MudText Typo="Typo.body1">
                                @context.Item.InviteeFullName
                            </MudText>
                            <MudText Typo="Typo.caption" Style="line-height: 1em">
                                @context.Item.InviteeEmail
                            </MudText>
                        </div>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Title="Project" Property="@(i => i.Project != null ? i.Project.Name : "Unknown")" />
                <PropertyColumn Title="Sent" Property="i => i.InviteDate" Format="g" />
            </Columns>
            <NoRecordsContent>
                <div class="py-3 text-center">
                    <MudText Typo="Typo.button" Color="Color.Tertiary">
                        No Cancelled/Expired Invites
                    </MudText>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter, EditorRequired]
    public IEnumerable<InviteDTO> Invites { get; set; } = [];

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private UserInfo? userInfo;

    [Parameter]
    public EventCallback OnChange { get; set; }

    private IEnumerable<InviteDTO> PendingInvites => Invites.Where(i => i.IsValid);
    private IEnumerable<InviteDTO> AcceptedInvites => Invites.Where(i => i.JoinDate.HasValue || !string.IsNullOrEmpty(i.InviteeId));
    private IEnumerable<InviteDTO> ExpiredInvites => Invites.Where(i => !i.IsValid && !i.JoinDate.HasValue);

    private async Task HandleCancelInviteAsync(int inviteId)
    {
        userInfo ??= await UserInfoHelper.GetUserInfoAsync(AuthStateTask);

        if (userInfo is null || !userInfo.IsInRole(Role.Admin))
        {
            return;
        }

        try
        {
            await InviteDTOService.CancelInviteAsync(inviteId, userInfo);
            Snackbar.Add("Invite cancelled successfully!", Severity.Success);

            await OnChange.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Snackbar.Add("An error occurred cancelling the invite!", Severity.Error);
        }
    }
}