@inject ICompanyDTOService CompanyService
@inject ISnackbar SnackBar

<MudText Typo="Typo.h6" GutterBottom>
    Members
</MudText>

@if (!isEditing)
{
    <div class="vstack gap-3">
        @foreach (Role role in Enum.GetValues<Role>())
        {
            if (role == Role.DemoUser)
                continue;

            IEnumerable<UserDTO> usersInRole = Members.Where(m => m.Role == role)
                                                      .OrderBy(m => m.FirstName)
                                                      .ThenBy(m => m.LastName);

            <div>
                <MudText Typo="Typo.button" GutterBottom>
                    @role.GetDisplayName()
                </MudText>

                <div class="d-flex flex-wrap">
                    @if (usersInRole.Any())
                    {
                        @foreach (UserDTO user in usersInRole)
                        {
                            <UserChip User="user" />
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.overline" Class="my-3">
                            No @(role.GetDisplayName())s
                        </MudText>
                    }
                </div>
            </div>
        }

        <AuthorizeView Roles="@nameof(Role.Admin)">
            <MudButton Class="me-auto"
                       Size="Size.Small"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Settings"
                       OnClick="() => isEditing = true">
                Manage Roles
            </MudButton>
        </AuthorizeView>
    </div>
}
else
{
    <MudDropContainer T="UserDTO"
                      Items="Members.OrderBy(m => m.FirstName).ThenBy(m => m.LastName)"
                      ItemsSelector="(UserDTO user, string zoneId) => user.Role.HasValue && Enum.GetName(user.Role.Value) == zoneId"
                      ItemDropped="HandleUserDropped"
                      CanDropClass="bg-secondary-subtle">

        <ItemRenderer>
            <UserChip User="context" />
        </ItemRenderer>

        <ChildContent>
            <div class="vstack gap-3">
                @foreach (Role role in Enum.GetValues<Role>())
                {
                    if (role == Role.DemoUser)
                    {
                        continue;
                    }

                    IEnumerable<UserDTO> usersInRole = Members.Where(m => m.Role == role);

                    <div>
                        <MudText Typo="Typo.button" GutterBottom>
                            @role.GetDisplayName()
                        </MudText>

                        <MudDropZone T="UserDTO" 
                                     Identifier="@Enum.GetName(role)"
                                     Class="d-flex flex-wrap rounded-3">

                            @if (!usersInRole.Any())
                            {
                                <MudText Typo="Typo.overline" Class="my-3">
                                    No @(role.GetDisplayName())s
                                </MudText>
                            }
                        </MudDropZone>
                    </div>
                }
            </div>
        </ChildContent>
    </MudDropContainer>

    <MudText Typo="Typo.subtitle1"
             Class="mt-3"
             GutterBottom>

        Drag and drop to assign users a role
    </MudText>

    <div class="hstack gap-2 mt-3">
        <MudButton Size="Size.Small"
                   Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Cancel"
                   OnClick="HandleCancelChangesAsync">
            Cancel
        </MudButton>
        <MudButton Size="Size.Small"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Variant="Variant.Filled"
                   OnClick="HandleSaveChangesAsync">
            Save Changes
        </MudButton>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IEnumerable<UserDTO> Members { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private UserInfo? userInfo;

    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        userInfo = await UserInfoHelper.GetUserInfoAsync(AuthStateTask);
    }

    private void HandleUserDropped(MudItemDropInfo<UserDTO> dropEvent)
    {
        if (dropEvent.Item is not null && Enum.TryParse<Role>(dropEvent.DropzoneIdentifier, out Role dropZoneRole))
        {
            dropEvent.Item.Role = dropZoneRole;
        }
    }

    private async Task HandleCancelChangesAsync()
    {
        await OnChanged.InvokeAsync();
        isEditing = false;
    }

    private async Task HandleSaveChangesAsync()
    {
        if (userInfo?.IsInRole(Role.Admin) == true)
        {
            try
            {
                var currentMembers = await CompanyService.GetUsersAsync(userInfo);

                foreach (UserDTO member in Members)
                {
                    if (member.Id == userInfo.UserId)
                    {
                        continue;
                    }

                    var currentRole = currentMembers.FirstOrDefault(u => u.Id == member.Id)?.Role;

                    if (currentRole.HasValue && member.Role.HasValue && currentRole != member.Role)
                    {
                        await CompanyService.AssignUserRoleAsync(member.Id, member.Role.Value, userInfo);
                    }
                }

                SnackBar.Add("Changes saved", Severity.Success);
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex);
                SnackBar.Add("An error occured updating the user roles, some changes may have not been saved.", Severity.Error);
            }
        }

        isEditing = false;
        await OnChanged.InvokeAsync();
    }
}